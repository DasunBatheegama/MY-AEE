# API Keys for RAG Suite
# Copy this file to .env and fill in your actual keys

# OpenAI (for GPT models and embeddings)
OPENAI_API_KEY=sk-your-openai-key-here

# Groq (for fast Llama inference)
GROQ_API_KEY=gsk_your-groq-key-here

# Google (for Gemini models)
GOOGLE_API_KEY=your-google-api-key-here

# Cohere (for embeddings and reranking)
COHERE_API_KEY=your-cohere-api-key-here

# HuggingFace (optional, for model downloads)
HUGGINGFACE_TOKEN=your-hf-token-here


OPENROUTER_API_KEY=your-openrouter-token-here